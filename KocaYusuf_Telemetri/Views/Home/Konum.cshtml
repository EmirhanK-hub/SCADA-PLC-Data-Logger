@{
    ViewData["Title"] = "Fabrika Konumu";
}

<style>
    body {
        background-color: #12161f;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .scada-card {
        background-color: #1a202c;
        border: 1px solid #2d3748;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
    }
</style>

<div class="container mt-4 pb-5">
    <div class="p-5 scada-card">
        <h1 class="fw-bold text-warning mb-3">📍 Fabrika ve Merkez Konum</h1>
        <p class="lead text-muted">
            Üretim tesislerimizi ziyaret etmek veya teknik yerinde inceleme talep etmek için aşağıdaki adres bilgilerimizi kullanabilirsiniz.
        </p>
        <hr class="border-secondary my-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <h4 class="text-light">Adres Bilgileri</h4>
                <p class="text-muted">Organize Sanayi Bölgesi, 4. Cadde No: 12<br>Merkez / Türkiye</p>
                <p class="text-muted"><strong>Çalışma Saatleri:</strong> Hafta içi 08:00 - 18:00</p>
            </div>
            <div class="col-md-6 mb-3">
                <h4 class="text-light">Ulaşım ve Lojistik</h4>
                <p class="text-muted">Ana otoyol bağlantılarına 5 dakika mesafede yer alan tesisimiz, geniş sevkiyat sahası ve modern idari binasıyla hizmet vermektedir.</p>
            </div>
        </div>
        <div class="mt-4">
            <a href="/Home/Index" class="btn btn-outline-info">⬅️ Ana Sayfaya Dön</a>
        </div>
    </div>
</div>