@{
    ViewData["Title"] = "Servis ve I/O Diagnostik";
}

<style>
    .ky-section-header {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid var(--ky-border);
    }

    .ky-section-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .ky-section-header h5 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .ky-section-count {
        margin-left: auto;
        font-size: 0.7rem;
        color: var(--ky-text-muted);
        background: rgba(255,255,255,0.05);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
    }

    /* --- Analog metrik kartları --- */
    .ky-chip-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.7rem;
        padding: 1.2rem 1.3rem;
    }

    .ky-analog-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .ky-analog-cell {
        background: var(--ky-bg-elevated);
        padding: 1.1rem 1.3rem;
        border-right: 1px solid var(--ky-border);
        border-bottom: 1px solid var(--ky-border);
    }

    @@media (min-width: 992px) {
        .ky-analog-cell:nth-child(4n) {
            border-right: none;
        }

        .ky-analog-cell:nth-child(n+5) {
            border-bottom: none;
        }
    }

    @@media (max-width: 991px) {
        .ky-chip-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .ky-analog-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .ky-analog-cell:nth-child(3n) {
            border-right: none;
        }

        .ky-analog-cell:nth-child(n+7) {
            border-bottom: none;
        }
    }

    @@media (max-width: 767px) {
        .ky-chip-grid {
            grid-template-columns: repeat(2, 1fr);
            padding: 1rem;
        }

        .ky-analog-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .ky-analog-cell:nth-child(2n) {
            border-right: none;
        }

        .ky-analog-cell:nth-child(n+7) {
            border-bottom: none;
        }
    }

    @@media (max-width: 480px) {
        .ky-chip-grid {
            grid-template-columns: 1fr;
        }

        .ky-analog-grid {
            grid-template-columns: 1fr;
        }

        .ky-analog-cell {
            border-right: none;
        }

            .ky-analog-cell:last-child {
                border-bottom: none;
            }
    }

    .ky-analog-cell .lbl {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        color: var(--ky-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .ky-analog-cell .val {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1;
    }

        .ky-analog-cell .val .unit {
            font-size: 0.8rem;
            color: var(--ky-text-muted);
            font-weight: 500;
            margin-left: 0.2rem;
        }

    /* --- Bit çipleri --- */
    .ky-bit-chip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        background: var(--ky-bg-elevated-2);
        border: 1px solid var(--ky-border);
        border-radius: var(--ky-radius-sm);
        padding: 0.7rem 0.9rem;
        transition: border-color 0.2s ease, transform 0.15s ease;
    }

        .ky-bit-chip:hover {
            border-color: var(--ky-border-strong);
            transform: translateY(-1px);
        }

        .ky-bit-chip.ky-chip-active {
            border-color: rgba(61,214,140,0.35);
            background: linear-gradient(120deg, var(--ky-success-soft), var(--ky-bg-elevated-2) 70%);
        }

    .ky-bit-chip-label {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }

    .ky-bit-chip-name {
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ky-bit-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        flex-shrink: 0;
    }

    .ky-bit-chip.ky-chip-active .ky-bit-dot {
        background: var(--ky-success);
        box-shadow: 0 0 8px rgba(61,214,140,0.7);
    }

    .ky-bit-status-text {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--ky-text-muted);
        flex-shrink: 0;
    }

    .ky-bit-chip.ky-chip-active .ky-bit-status-text {
        color: var(--ky-success);
    }
</style>

<div class="ky-hero">
    <span class="ky-hero-eyebrow"><i class="fas fa-microchip"></i> Diagnostik</span>
    <h1>Servis / I/O Paneli</h1>
    <p>PLC register ve bit seviyesinde canlı teknik izleme</p>
</div>

<!-- ANALOG DEĞERLER -->
<div class="ky-card mb-4">
    <div class="ky-section-header">
        <span class="ky-section-icon" style="background: var(--ky-accent-soft); color: var(--ky-accent);"><i class="fas fa-gauge-high"></i></span>
        <h5>Analog Proses Değerleri</h5>
    </div>
    <div class="ky-analog-grid">
        <div class="ky-analog-cell">
            <span class="lbl">Hidrolik Basınç <span class="ky-tag">DT110</span></span>
            <span class="val" style="color: var(--ky-accent);" id="val_hid">–</span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Ana Hava Basıncı <span class="ky-tag">DT112</span></span>
            <span class="val" style="color: var(--ky-accent);" id="val_hava">–</span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Ara Hava Basıncı <span class="ky-tag">DT212</span></span>
            <span class="val" style="color: var(--ky-accent);" id="val_ara">–</span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Balon Sıcaklığı <span class="ky-tag">DT126</span></span>
            <span class="val" style="color: var(--ky-danger);"><span id="val_balon">–</span> <span class="unit">°C</span></span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Pres Sıcaklığı <span class="ky-tag">DT82</span></span>
            <span class="val" style="color: var(--ky-danger);"><span id="val_pres">–</span> <span class="unit">/ <span id="val_presset">–</span> °C</span></span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Üretim Sayacı <span class="ky-tag">R36</span></span>
            <span class="val" style="color: var(--ky-success);" id="val_uretim">–</span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl">Genel Durum Kodu <span class="ky-tag">DT36</span></span>
            <span class="val" style="color: var(--ky-info);" id="val_durumkodu">–</span>
        </div>
        <div class="ky-analog-cell">
            <span class="lbl text-warning">HMI Mesaj Kodu <span class="ky-tag text-dark">DT60</span></span>
            <span class="val" style="color: var(--ky-warning);" id="val_dt60">–</span>
        </div>
    </div>
</div>

