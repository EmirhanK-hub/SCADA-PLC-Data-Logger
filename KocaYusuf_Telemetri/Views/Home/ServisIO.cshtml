        <div class="ky-bit-chip" id="chip_y64"><div class="ky-bit-chip-label"><span class="ky-bit-chip-name">Solenoid Valf S16</span><span class="ky-tag">Y64</span></div><div class="d-flex align-items-center gap-2"><span class="ky-bit-status-text" id="bit_y64">…</span><span class="ky-bit-dot"></span></div></div>
    </div>
</div>

@section Scripts {
    <script>
        function bitGuncelle(elementId, deger) {
            var textEl = document.getElementById(elementId);
            if (!textEl) return;
            var chipEl = document.getElementById('chip_' + elementId.replace('bit_', ''));

            if (deger) {
                textEl.innerText = "AKTİF";
                if (chipEl) chipEl.classList.add('ky-chip-active');
            } else {
                textEl.innerText = "PASİF";
                if (chipEl) chipEl.classList.remove('ky-chip-active');
            }
        }

        function servisVeriCek() {
            fetch('/Home/CanliVeriGetir')
                .then(response => response.json())
                .then(data => {
                    if (!data) return;

                    // Analog Değerler (Modeldeki property isimleriyle tam uyumlu)
                    document.getElementById('val_hid').innerHTML = (data.dt110_HidrolikBasincHMI ?? data.dT110_HidrolikBasincHMI ?? "-") + " <span class=\"unit\">bar</span>";
                    document.getElementById('val_hava').innerHTML = (data.dt112_AnaHavaBasinciHMI ?? data.dT112_AnaHavaBasinciHMI ?? "-") + " <span class=\"unit\">bar</span>";
                    document.getElementById('val_ara').innerHTML = (data.dt212_AraHavaBasinciHMI ?? data.dT212_AraHavaBasinciHMI ?? "-") + " <span class=\"unit\">bar</span>";

                    document.getElementById('val_balon').innerText = data.balonSicakligi ?? "-";
                    document.getElementById('val_pres').innerText = data.presSicakligi ?? "-";
                    document.getElementById('val_presset').innerText = data.dT32538_PresSicaklikSet ?? data.dt32538_PresSicaklikSet ?? "-";

                    document.getElementById('val_uretim').innerText = data.uretimAdedi ?? "-";
                    document.getElementById('val_durumkodu').innerText = data.genelDurumKodu ?? "-";

                    const dt60Value = data.dT60_IstenenHMIMesaji ?? data.dt60_IstenenHMIMesaji;
                    document.getElementById('val_dt60').innerText = dt60Value != null ? "K" + dt60Value : "-";

                    // Durum Bitleri (R) - Modeldeki güncel isimlerle eşleştirildi
                    bitGuncelle('bit_r5', data.r5_MakineCalisiyor);
                    bitGuncelle('bit_r7', data.r7_MakineHazir);
